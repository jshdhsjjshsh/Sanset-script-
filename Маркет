local AutoBuy = {}
AutoBuy.__index = AutoBuy

function AutoBuy.new(core, analyzer)
    local self = setmetatable({}, AutoBuy)
    self.core = core
    self.analyzer = analyzer
    self.target = ""
    self.maxPrice = 0
    self.currency = "_StarsValue"
    self.running = false
    self.task = nil
    self.buyCount = 0
    self.learningData = {
        attempts = 0,
        successful = 0,
        avgPrice = 0,
        bestPrice = math.huge,
        worstPrice = 0,
        successRate = 0,
        learnedPatterns = {}
    }
    return self
end

function AutoBuy:learn(price, success, name)
    self.learningData.attempts = self.learningData.attempts + 1
    if success then
        self.learningData.successful = self.learningData.successful + 1
        self.learningData.avgPrice = (self.learningData.avgPrice * (self.learningData.successful - 1) + price) / self.learningData.successful
        if price < self.learningData.bestPrice then
            self.learningData.bestPrice = price
        end
        if price > self.learningData.worstPrice then
            self.learningData.worstPrice = price
        end
        
        -- Запоминаем успешный паттерн
        if not self.learningData.learnedPatterns[name] then
            self.learningData.learnedPatterns[name] = {prices = {}, successes = 0}
        end
        table.insert(self.learningData.learnedPatterns[name].prices, price)
        self.learningData.learnedPatterns[name].successes = self.learningData.learnedPatterns[name].successes + 1
    end
    self.learningData.successRate = self.learningData.successful / self.learningData.attempts
    DataTables.learningData = self.learningData
    saveData()
end

function AutoBuy:shouldBuy(name, price)
    -- Используем обучение для принятия решения
    local pattern = self.learningData.learnedPatterns[name]
    if pattern and #pattern.prices > 3 then
        local avg = 0
        for _, v in ipairs(pattern.prices) do
            avg = avg + v
        end
        avg = avg / #pattern.prices
        -- Если цена ниже средней успешной покупки
        if price < avg * 1.1 then
            return true
        end
    end
    return price <= self.maxPrice
end

function AutoBuy:start(target, maxPrice, currency)
    self.target = target
    self.maxPrice = maxPrice
    self.currency = currency or "_StarsValue"
    self.running = true
    self.buyCount = 0
    self.core.state.isAutoBuyActive = true
    
    self.task = RunService.Heartbeat:Connect(function()
        if not self.running then return end
        local cache = self.core.state.marketCache[self.currency]
        if not cache then return end
        local item = cache[self.target]
        if item and not item.owner and self:shouldBuy(self.target, item.value) then
            local ok, res = self.core:buyItem(item.ref)
            if ok and res and res[1] then
                self.buyCount = self.buyCount + 1
                self.core.state.stats.totalBuys = self.core.state.stats.totalBuys + 1
                self:learn(item.value, true, self.target)
                self.core:notify(
                    "Auto-Buy",
                    string.format("Куплен %s за %s %s (Обучение: %d%% успеха)", 
                        self.target, 
                        self.core.cache.currencySymbols[self.currency],
                        tostring(item.value),
                        math.floor(self.learningData.successRate * 100)
                    )
                )
                self:stop()
            else
                self.core.state.stats.failedAttempts = self.core.state.stats.failedAttempts + 1
                self:learn(item.value, false, self.target)
            end
        end
    end)
end

function AutoBuy:stop()
    self.running = false
    self.core.state.isAutoBuyActive = false
    if self.task then
        self.task:Disconnect()
        self.task = nil
    end
end

function AutoBuy:getStatus()
    return {
        running = self.running,
        target = self.target,
        maxPrice = self.maxPrice,
        buys = self.buyCount,
        learning = self.learningData
    }
end

