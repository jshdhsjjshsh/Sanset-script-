local Flipper = {}
Flipper.__index = Flipper

function Flipper.new(core, analyzer)
    local self = setmetatable({}, Flipper)
    self.core = core
    self.analyzer = analyzer
    self.settings = {}
    self.running = false
    self.task = nil
    self.currency = "_StarsValue"
    self.profitHistory = DataTables.tradeHistory or {}
    self.tradeCount = 0
    self.successRate = 0
    self.learningData = {
        buyPatterns = {},
        sellPatterns = {},
        profitablePairs = {},
        avgProfit = 0,
        totalTrades = 0,
        successfulTrades = 0
    }
    return self
end

function Flipper:learn(name, buyPrice, sellPrice, success)
    self.learningData.totalTrades = self.learningData.totalTrades + 1
    if success then
        self.learningData.successfulTrades = self.learningData.successfulTrades + 1
        local profit = sellPrice - buyPrice
        self.learningData.avgProfit = (self.learningData.avgProfit * (self.learningData.successfulTrades - 1) + profit) / self.learningData.successfulTrades
        
        if not self.learningData.profitablePairs[name] then
            self.learningData.profitablePairs[name] = {profits = {}, count = 0}
        end
        table.insert(self.learningData.profitablePairs[name].profits, profit)
        self.learningData.profitablePairs[name].count = self.learningData.profitablePairs[name].count + 1
    end
    self.successRate = self.learningData.successfulTrades / self.learningData.totalTrades
    DataTables.learningData = self.learningData
    saveData()
end

function Flipper:addSettings(name, buyMax, sellPrice)
    -- Проверяем, есть ли в анализе подсказки
    local analysis = self.analyzer.data[self.currency]
    if analysis and analysis[name] then
        local data = analysis[name]
        -- Корректируем цены на основе анализа
        if buyMax > data.recommendedBuy and data.discount > 0.1 then
            buyMax = math.min(buyMax, data.recommendedBuy * 1.1)
        end
        if sellPrice < data.recommendedSell and data.trend == "rising" then
            sellPrice = math.max(sellPrice, data.recommendedSell * 0.9)
        end
    end
    
    self.settings[name] = {
        buyMax = buyMax,
        sellPrice = sellPrice,
        lastBuy = 0,
        lastSell = 0,
        attempts = 0,
        successes = 0,
        totalProfit = 0
    }
end

function Flipper:start(currency)
    self.currency = currency or "_StarsValue"
    self.running = true
    self.core.state.isFlipperActive = true
    
    self.task = RunService.Heartbeat:Connect(function()
        if not self.running then return end
        local cache = self.core.state.marketCache[self.currency]
        if not cache then return end
        
        for name, settings in pairs(self.settings) do
            if settings.buyMax and settings.buyMax > 0 then
                local item = cache[name]
                if item and item.value <= settings.buyMax and not item.owner then
                    -- Проверяем, не слишком ли быстро мы покупаем
                    local timeSinceLastBuy = os.time() - settings.lastBuy
                    if timeSinceLastBuy > 5 then
                        local ok, res = self.core:buyItem(item.ref)
                        if ok and res and res[1] then
                            settings.lastBuy = os.time()
                            self.core.state.stats.totalBuys = self.core.state.stats.totalBuys + 1
                            
                            if settings.sellPrice and settings.sellPrice > 0 then
                                local currencyTable = {}
                                currencyTable[self.currency] = settings.sellPrice
                                local placeSuccess = self.core:placeOffer(name, currencyTable)
                                if placeSuccess then
                                    settings.lastSell = os.time()
                                    self.core.state.stats.totalSells = self.core.state.stats.totalSells + 1
                                    local profit = settings.sellPrice - item.value
                                    self.core.state.stats.profit = self.core.state.stats.profit + profit
                                    settings.totalProfit = settings.totalProfit + profit
                                    settings.successes = settings.successes + 1
                                    
                                    self:learn(name, item.value, settings.sellPrice, true)
                                    
                                    self.core:notify(
                                        "Flipper",
                                        string.format("Перекуплен %s: куплен за %s, продан за %s, прибыль %s (Успех: %d%%)",
                                            name,
                                            tostring(item.value),
                                            tostring(settings.sellPrice),
                                            tostring(profit),
                                            math.floor(self.successRate * 100)
                                        )
                                    )
                                else
                                    self:learn(name, item.value, settings.sellPrice, false)
                                end
                            end
                        end
                        settings.attempts = settings.attempts + 1
                    end
                end
            end
        end
    end)
end

function Flipper:stop()
    self.running = false
    self.core.state.isFlipperActive = false
    if self.task then
        self.task:Disconnect()
        self.task = nil
    end
end

function Flipper:getStatus()
    return {
        running = self.running,
        currency = self.currency,
        settings = self.settings,
        totalBuys = self.core.state.stats.totalBuys,
        totalSells = self.core.state.stats.totalSells,
        profit = self.core.state.stats.profit,
        successRate = self.successRate,
        learningData = self.learningData
    }
end

