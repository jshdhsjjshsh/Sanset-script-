function Core.new()
    local self = setmetatable({}, Core)
    
    self.state = {
        currentCurrency = "_StarsValue",
        isAutoBuyActive = false,
        isFlipperActive = false,
        isScanning = false,
        isRunning = false,
        autoBuyTask = nil,
        flipperTask = nil,
        scanTask = nil,
        marketCache = {},
        inventoryCache = {},
        priceHistory = DataTables.priceHistory or {},
        stats = DataTables.stats or {
            totalBuys = 0,
            totalSells = 0,
            profit = 0,
            failedAttempts = 0,
            startTime = os.time(),
            successfulTrades = 0,
            totalTrades = 0,
            profitHistory = {},
            bestTrade = 0,
            worstTrade = 0,
            averageProfit = 0
        },
        updateInterval = 1.5,
        lastUpdate = 0,
        lastScan = 0,
        connections = {},
        isLearning = true,
        learningThreshold = 0.85
    }
    
    self.cache = {
        gifts = {},
        marketFolders = {},
        currencySymbols = {
            _StarsValue = "⭐",
            _GemsValue = "💎",
            _TONValue = "💠"
        }
    }
    
    self.analytics = {
        marketTrends = {},
        pricePatterns = {},
        bestTimes = {},
        successfulPatterns = {},
        failedPatterns = {}
    }
    
    self:initCache()
    self:setupOptimization()
    self:setupEventHandlers()
    self:setupLearningSystem()
    
    return self
end

function Core:initCache()
    if Info and Info.Gifts then
        for name, data in pairs(Info.Gifts) do
            if not data.Hidden then
                self.cache.gifts[name] = data
            end
        end
    end
    
    local market = ReplicatedStorage:FindFirstChild("Market")
    if market then
        for _, currency in pairs({"_StarsValue", "_GemsValue", "_TONValue"}) do
            local folder = market:FindFirstChild(currency)
            if folder then
                self.cache.marketFolders[currency] = folder
            end
        end
    end
end

function Core:setupLearningSystem()
    self.state.connections.learningLoop = RunService.Heartbeat:Connect(function()
        if self.state.isLearning then
            self:analyzeAndLearn()
        end
    end)
end

function Core:analyzeAndLearn()
    -- Анализ текущего рынка
    for currency, cache in pairs(self.state.marketCache) do
        for name, item in pairs(cache) do
            -- Собираем данные о ценах
            if not DataTables.marketData[name] then
                DataTables.marketData[name] = {
                    prices = {},
                    timestamps = {},
                    currency = currency,
                    minPrice = math.huge,
                    maxPrice = 0,
                    averagePrice = 0,
                    volatility = 0,
                    trend = "stable"
                }
            end
            
            local data = DataTables.marketData[name]
            table.insert(data.prices, item.value)
            table.insert(data.timestamps, os.time())
            
            -- Обновляем статистику
            if item.value < data.minPrice then data.minPrice = item.value end
            if item.value > data.maxPrice then data.maxPrice = item.value end
            
            -- Вычисляем среднюю цену
            local sum = 0
            for _, v in ipairs(data.prices) do
                sum = sum + v
            end
            data.averagePrice = sum / #data.prices
            
            -- Вычисляем волатильность
            if #data.prices > 1 then
                local variance = 0
                for _, v in ipairs(data.prices) do
                    variance = variance + (v - data.averagePrice) ^ 2
                end
                data.volatility = math.sqrt(variance / (#data.prices - 1))
            end
            
            -- Определяем тренд
            if #data.prices > 5 then
                local lastPrices = {}
                for i = #data.prices - 5, #data.prices do
                    table.insert(lastPrices, data.prices[i])
                end
                local trend = 0
                for i = 2, #lastPrices do
                    trend = trend + (lastPrices[i] - lastPrices[i-1])
                end
                if trend > 0 then
                    data.trend = "rising"
                elseif trend < 0 then
                    data.trend = "falling"
                else
                    data.trend = "stable"
                end
            end
            
            -- Прогнозируем цену
            if #data.prices > 3 then
                local avgChange = 0
                for i = #data.prices - 2, #data.prices do
                    avgChange = avgChange + (data.prices[i] - data.prices[i-1])
                end
                avgChange = avgChange / 3
                data.predictedPrice = data.prices[#data.prices] + avgChange
            else
                data.predictedPrice = data.averagePrice
            end
            
            -- Сохраняем в таблицу для инжектора
            DataTables.analyzedData[name] = data
        end
    end
    
    saveData()
end

function Core:setupOptimization()
    self.state.connections.heartbeat = RunService.Heartbeat:Connect(function(deltaTime)
        self.state.lastUpdate = self.state.lastUpdate + deltaTime
        if self.state.lastUpdate >= self.state.updateInterval then
            self.state.lastUpdate = 0
            self:updateMarketCache()
        end
    end)
    
    self.state.connections.renderStepped = RunService.RenderStepped:Connect(function()
        if self.state.isAutoBuyActive or self.state.isFlipperActive then
            self:fastScan()
        end
    end)
end

function Core:setupEventHandlers()
    for currency, folder in pairs(self.cache.marketFolders) do
        local connAdd = folder.DescendantAdded:Connect(function(item)
            if item:IsA("IntValue") then
                self:onMarketItemAdded(currency, item)
            end
        end)
        local connRem = folder.DescendantRemoved:Connect(function(item)
            if item:IsA("IntValue") then
                self:onMarketItemRemoved(currency, item)
            end
        end)
        table.insert(self.state.connections, connAdd)
        table.insert(self.state.connections, connRem)
    end
    
    local inventory = player:FindFirstChild("_Inventory")
    if inventory then
        local connInv = inventory.DescendantAdded:Connect(function(item)
            if item:IsA("IntValue") then
                self.state.inventoryCache[item.Name] = {value = item.Value, ref = item}
            end
        end)
        table.insert(self.state.connections, connInv)
        local connInvRem = inventory.DescendantRemoved:Connect(function(item)
            if item:IsA("IntValue") then
                self.state.inventoryCache[item.Name] = nil
            end
        end)
        table.insert(self.state.connections, connInvRem)
    end
end

function Core:fastScan()
    local currency = self.state.currentCurrency
    local folder = self.cache.marketFolders[currency]
    if not folder then return end
    
    if not self.state.marketCache[currency] then
        self.state.marketCache[currency] = {}
    end
    local cache = self.state.marketCache[currency]
    
    for _, item in pairs(folder:GetChildren()) do
        if item:IsA("IntValue") then
            local existing = cache[item.Name]
            if not existing or existing.value ~= item.Value or existing.owner ~= item:GetAttribute("Owner") then
                cache[item.Name] = {
                    value = item.Value,
                    ref = item,
                    owner = item:GetAttribute("Owner"),
                    timestamp = os.time()
                }
            end
        end
    end
end

function Core:updateMarketCache()
    for currency, folder in pairs(self.cache.marketFolders) do
        if not self.state.marketCache[currency] then
            self.state.marketCache[currency] = {}
        end
        local cache = self.state.marketCache[currency]
        for _, item in pairs(folder:GetChildren()) do
            if item:IsA("IntValue") then
                cache[item.Name] = {
                    value = item.Value,
                    ref = item,
                    owner = item:GetAttribute("Owner"),
                    timestamp = os.time()
                }
            end
        end
    end
end

function Core:onMarketItemAdded(currency, item)
    if not self.state.marketCache[currency] then
        self.state.marketCache[currency] = {}
    end
    self.state.marketCache[currency][item.Name] = {
        value = item.Value,
        ref = item,
        owner = item:GetAttribute("Owner"),
        timestamp = os.time()
    }
    
    -- Записываем в историю
    if not DataTables.priceHistory[item.Name] then
        DataTables.priceHistory[item.Name] = {}
    end
    table.insert(DataTables.priceHistory[item.Name], {
        price = item.Value,
        currency = currency,
        timestamp = os.time()
    })
    
    if self.state.isAutoBuyActive then
        self:processAutoBuyCheck(currency, item)
    end
    if self.state.isFlipperActive then
        self:processFlipperCheck(currency, item)
    end
end

function Core:onMarketItemRemoved(currency, item)
    if self.state.marketCache[currency] then
        self.state.marketCache[currency][item.Name] = nil
    end
end

