local Analyzer = {}
Analyzer.__index = Analyzer

function Analyzer.new(core)
    local self = setmetatable({}, Analyzer)
    self.core = core
    self.data = {}
    self.isScanning = false
    self.lastScan = 0
    self.analysisResults = {}
    return self
end

function Analyzer:scan()
    if self.isScanning then return end
    self.isScanning = true
    
    local result = {}
    for currency, folder in pairs(self.core.cache.marketFolders) do
        local items = {}
        for _, item in pairs(folder:GetChildren()) do
            if item:IsA("IntValue") then
                local name = item.Name
                if not items[name] then
                    items[name] = {
                        prices = {},
                        min = math.huge,
                        max = 0,
                        sum = 0,
                        count = 0,
                        owners = {},
                        timestamps = {}
                    }
                end
                local data = items[name]
                table.insert(data.prices, item.Value)
                data.sum = data.sum + item.Value
                data.count = data.count + 1
                if item.Value < data.min then data.min = item.Value end
                if item.Value > data.max then data.max = item.Value end
                local owner = item:GetAttribute("Owner")
                if owner then
                    data.owners[owner] = (data.owners[owner] or 0) + 1
                end
                table.insert(data.timestamps, os.time())
            end
        end
        
        for name, data in pairs(items) do
            if data.count > 0 then
                data.average = data.sum / data.count
                data.median = self:calculateMedian(data.prices)
                data.standardDeviation = self:calculateStdDev(data.prices, data.average)
                data.recommendedSell = math.floor(data.average * 1.15)
                data.recommendedBuy = math.floor(data.average * 0.85)
                data.discount = 1 - (data.min / data.average)
                data.volatility = data.max - data.min
                data.currency = currency
                
                -- Анализ тренда
                data.trend = self:analyzeTrend(data.prices)
                
                -- Прогноз
                data.prediction = self:predictPrice(data.prices)
                
                -- Оценка ликвидности
                data.liquidity = data.count / #folder:GetChildren() * 100
                
                -- Рейтинг
                data.rating = self:calculateRating(data)
            end
        end
        
        result[currency] = items
    end
    
    self.data = result
    self.isScanning = false
    self.lastScan = os.time()
    self.analysisResults = result
    DataTables.analyzedData = result
    saveData()
    
    return result
end

function Analyzer:calculateMedian(prices)
    local sorted = {}
    for _, v in ipairs(prices) do
        table.insert(sorted, v)
    end
    table.sort(sorted)
    local len = #sorted
    if len == 0 then return 0 end
    if len % 2 == 1 then
        return sorted[math.floor(len/2) + 1]
    else
        return (sorted[len/2] + sorted[len/2 + 1]) / 2
    end
end

function Analyzer:calculateStdDev(prices, average)
    if #prices <= 1 then return 0 end
    local sum = 0
    for _, v in ipairs(prices) do
        sum = sum + (v - average) ^ 2
    end
    return math.sqrt(sum / (#prices - 1))
end

function Analyzer:analyzeTrend(prices)
    if #prices < 3 then return "insufficient" end
    local trend = 0
    for i = 2, #prices do
        trend = trend + (prices[i] - prices[i-1])
    end
    trend = trend / (#prices - 1)
    if trend > 0.05 then return "rising"
    elseif trend < -0.05 then return "falling"
    else return "stable" end
end

function Analyzer:predictPrice(prices)
    if #prices < 3 then return prices[#prices] or 0 end
    local weights = {0.5, 0.3, 0.2}
    local prediction = 0
    for i = 1, math.min(3, #prices) do
        prediction = prediction + prices[#prices - i + 1] * weights[i]
    end
    return math.floor(prediction)
end

function Analyzer:calculateRating(data)
    local rating = 0
    -- Ликвидность
    if data.liquidity > 50 then rating = rating + 30
    elseif data.liquidity > 20 then rating = rating + 20
    else rating = rating + 10 end
    
    -- Скидка
    if data.discount > 0.3 then rating = rating + 30
    elseif data.discount > 0.15 then rating = rating + 20
    else rating = rating + 10 end
    
    -- Волатильность
    if data.volatility < 100 then rating = rating + 20
    elseif data.volatility < 500 then rating = rating + 10
    else rating = rating + 5 end
    
    -- Тренд
    if data.trend == "rising" then rating = rating + 20
    elseif data.trend == "stable" then rating = rating + 10
    else rating = rating + 5 end
    
    return math.min(rating, 100)
end

function Analyzer:getDeals(currency, limit)
    limit = limit or 20
    local deals = {}
    local data = self.data[currency]
    if not data then return deals end
    
    for name, info in pairs(data) do
        if info.count > 1 and info.discount > 0.05 then
            table.insert(deals, {
                name = name,
                min = info.min,
                average = info.average,
                median = info.median,
                max = info.max,
                discount = info.discount,
                count = info.count,
                volatility = info.volatility,
                trend = info.trend,
                prediction = info.prediction,
                liquidity = info.liquidity,
                rating = info.rating,
                recommendedBuy = info.recommendedBuy,
                recommendedSell = info.recommendedSell,
                currency = info.currency
            })
        end
    end
    
    table.sort(deals, function(a, b)
        return a.rating > b.rating
    end)
    
    local result = {}
    for i = 1, math.min(limit, #deals) do
        table.insert(result, deals[i])
    end
    return result
end

function Analyzer:getTopDeals(currency, minRating, limit)
    minRating = minRating or 70
    limit = limit or 10
    local deals = self:getDeals(currency, 50)
    local result = {}
    for _, deal in ipairs(deals) do
        if deal.rating >= minRating then
            table.insert(result, deal)
            if #result >= limit then break end
        end
    end
    return result
end

