local function LoadConfig()
    if not _hasFileApi() then return nil end
    local data = {}
    if isfile(CONFIG_FILE) then
        local ok, s = pcall(function() return _hs:JSONDecode(readfile(CONFIG_FILE)) end)
        if ok and type(s) == "table" then for k, v in pairs(s) do data[k] = v end end
    end
    if isfile(CONFIG_MONEY) then
        local ok, m = pcall(function() return _hs:JSONDecode(readfile(CONFIG_MONEY)) end)
        if ok and type(m) == "table" then
            data.fakeMoney = m.amount or 0
            data.fakeMoneyActive = m.active or false
        end
    end
    if isfile(CONFIG_BRAINROTS) then
        local ok, b = pcall(function() return _hs:JSONDecode(readfile(CONFIG_BRAINROTS)) end)
        if ok and type(b) == "table" then data.spawns = b end
    end
    if isfile(CONFIG_SKINS) then
        local ok, sk = pcall(function() return _hs:JSONDecode(readfile(CONFIG_SKINS)) end)
        if ok and type(sk) == "table" then data.baseSkin = sk.skin or "" end
    end
    if type(data) ~= "table" then return nil end
    if type(data.autoRestore) == "boolean" then autoRestoreEnabled = data.autoRestore end
    if type(data.autoSave) == "boolean" then autoSaveEnabled = data.autoSave end
    if type(data.hideOnRejoin) == "boolean" then hideOnRejoinEnabled = data.hideOnRejoin end
    if type(data.lastSessionEnd) == "number" then
        local elapsed = os.time() - data.lastSessionEnd
        if elapsed > 0 then _offlineSeconds = math.min(elapsed, 18000) end
    end
    local function _validKeyCode(s)
        if type(s) ~= "string" then return false end
        if s == "" then return true end
        local ok, item = pcall(function() return Enum.KeyCode[s] end)
        return ok and item ~= nil
    end
    if _validKeyCode(data.toggleKey) and data.toggleKey ~= "" then toggleKeyName = data.toggleKey end
    if _validKeyCode(data.rejoinKey) then rejoinKeyName = data.rejoinKey end
    if _validKeyCode(data.debugDupeKey) then _debugDupeKeyName = data.debugDupeKey or "" end
    if _validKeyCode(data.debugAutoFillKey) then _debugAutoFillKeyName = data.debugAutoFillKey or "" end
    if _validKeyCode(data.debugTradeNotifKey) then _debugTradeNotifKeyName = data.debugTradeNotifKey or "" end
    if type(data.windowPos) == "table" then savedWindowPos = data.windowPos end
    if type(data.baseSkin) == "string" then _savedBaseSkin = data.baseSkin end
    if type(data.fakeConfirmDelay) == "number" then fakeConfirmDelay = data.fakeConfirmDelay end
    if type(data.fakeAcceptDelay) == "number" then fakeAcceptDelay = data.fakeAcceptDelay end
    if type(data.fakeMoney) == "number" then
        _clientVisualMoney = data.fakeMoney
        _clientVisualMoneyActive = data.fakeMoneyActive == true
    end
    return data
end


