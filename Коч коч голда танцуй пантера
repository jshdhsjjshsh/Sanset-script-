local function _oneSetBannerTreeVisible(banner, visible)
    if not banner then return end
    banner.Visible = visible
    local parent = banner.Parent
    while parent and parent:IsA("GuiObject") do
        parent.Visible = visible
        parent = parent.Parent
    end
end

local function _oneBannerPosition(banner)
    if not banner or not banner.Parent then return nil, nil end
    local gui = banner:FindFirstAncestorWhichIsA("SurfaceGui")
        or banner:FindFirstAncestorWhichIsA("BillboardGui")
    if not gui then return nil, nil end
    local adornee = gui.Adornee
    if not adornee and gui.Parent and gui.Parent:IsA("BasePart") then
        adornee = gui.Parent
    end
    if adornee and adornee:IsA("BasePart") then
        local motor = adornee:FindFirstChild("__foh_transform")
        if motor and motor:IsA("Motor6D") then
            return motor.Transform.Position, gui
        end
        return adornee.Position, gui
    end
    return nil, gui
end

local function _oneApplyBanner(model)
    if not model or not model.Parent then return false end
    local ok, targetPosition = pcall(function() return model:GetPivot().Position end)
    if not ok or not targetPosition then return false end
    local bestBanner, bestDistance = nil, math.huge
    for _, descendant in ipairs(workspace:GetDescendants()) do
        if descendant.Name == "1OF1Banner" and descendant:IsA("GuiObject") then
            local position, gui = _oneBannerPosition(descendant)
            local displayName = gui and gui:FindFirstChild("DisplayName", true)
            local matches = not displayName
                or displayName.Text == model.Name
                or string.find(displayName.Text, model.Name, 1, true)
            if position and matches then
                local distance = (position - targetPosition).Magnitude
                if distance < bestDistance then
                    bestDistance = distance
                    bestBanner = descendant
                end
            end
        end
    end
    if bestBanner then
        _oneSetBannerTreeVisible(bestBanner, true)
        model:SetAttribute("Is1of1", true)
        local snap = modelSnapshots[model]
        if snap then snap.is1of1 = true end
        if ScheduleSave then pcall(ScheduleSave) end
        return true
    end
    return false
end

