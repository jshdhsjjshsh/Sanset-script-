local _clientVisualMoneyActive = false

local function _parseVisualMoney(text)
    if type(text) ~= "string" then return nil end
    local clean = text:gsub(",", ""):gsub("%$", ""):gsub("%s", "")
    local number, suffix = clean:match("^([%d%.]+)([KMBT]?)")
    number = tonumber(number)
    if not number then return nil end
    local multipliers = {K=1e3, M=1e6, B=1e9, T=1e12}
    return number * (multipliers[suffix] or 1)
end

local function _formatVisualMoney(number)
    local function trim(value, suffix)
        return value:gsub("%.0+"..suffix, suffix):gsub("(%.%d-)0+"..suffix, "%1"..suffix)
    end
    if number >= 1e12 then return "$"..trim(string.format("%.2fT", number/1e12), "T") end
    if number >= 1e9 then return "$"..trim(string.format("%.2fB", number/1e9), "B") end
    if number >= 1e6 then return "$"..trim(string.format("%.2fM", number/1e6), "M") end
    if number >= 1e3 then return "$"..trim(string.format("%.2fK", number/1e3), "K") end
    return "$"..tostring(math.floor(number))
end

local function _isMoneyDisplay(object)
    if not (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) then
        return false
    end
    if type(object.Text) ~= "string" or not object.Text:match("^%s*%$") then
        return false
    end
    local current = object
    local isCurrency = false
    for _ = 1, 8 do
        if not current then break end
        local name = current.Name:lower()
        if name:find("trade", 1, true)
            or name:find("kingvisuals", 1, true)
            or name:find("rubycc", 1, true)
            or name:find("index", 1, true)
            or name:find("backpack", 1, true)
            or name:find("inventory", 1, true)
            or name:find("slot", 1, true)
            or name:find("spacer", 1, true)
            or name:find("animal", 1, true)
            or name:find("brainrot", 1, true)
            or name:find("shop", 1, true)
            or name:find("purchase", 1, true)
            or name:find("cashpad", 1, true)
            or name:find("collect", 1, true) then
            return false
        end
        if name:find("money", 1, true) or name:find("cash", 1, true) or name:find("currency", 1, true) then
            isCurrency = true
        end
        current = current.Parent
    end
    return isCurrency
end

local function _readClientMoney()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, name in ipairs({"Money", "Cash", "Currency"}) do
            local value = leaderstats:FindFirstChild(name)
            if value and (value:IsA("NumberValue") or value:IsA("IntValue")) then
                return value.Value
            end
        end
    end
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, object in ipairs(playerGui:GetDescendants()) do
            if _isMoneyDisplay(object) then
                local parsed = _parseVisualMoney(object.Text)
                if parsed then return parsed end
            end
        end
    end
    return 0
end

local function _applyClientMoney()
    if not _clientVisualMoneyActive or _clientVisualMoney == nil then return end
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, name in ipairs({"Money", "Cash", "Currency"}) do
            local value = leaderstats:FindFirstChild(name)
            if value and (value:IsA("NumberValue") or value:IsA("IntValue")) then
                pcall(function() value.Value = _clientVisualMoney end)
            end
        end
    end
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        local formatted = _formatVisualMoney(_clientVisualMoney)
        for _, object in ipairs(playerGui:GetDescendants()) do
            if _isMoneyDisplay(object) then
                object.Text = formatted
            end
        end
    end
end

local function _addClientMoney(amount)
    amount = tonumber(amount) or 0
    if amount <= 0 then return end
    if _clientVisualMoney == nil then
        _clientVisualMoney = _readClientMoney()
    end
    _clientVisualMoney = math.max(0, _clientVisualMoney + amount)
    _clientVisualMoneyActive = true
    _applyClientMoney()
    if ScheduleSave then pcall(ScheduleSave) end
end

